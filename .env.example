TOTH_WORKSPACE=~/toth/workspace

# Per-profile local image overrides (Phase 2, Tier 1).
# Point the wrapper at an already-built/pulled local image under a different
# name or tag, without changing where `toth update <profile>` pulls from
# (that always follows TOTH_REGISTRY + TOTH_IMAGE_VERSION above).
#
# TOTH_PROFILE_<NAME>_IMAGE fully replaces the local image reference:
# TOTH_PROFILE_DFIR_IMAGE=my-custom-dfir:latest
#
# TOTH_PROFILE_<NAME>_TAG keeps the default image name but swaps the tag:
# TOTH_PROFILE_DFIR_TAG=0.2.0-rc1
#
# If both are set for the same profile, TOTH_PROFILE_<NAME>_IMAGE wins.
